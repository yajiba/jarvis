{
  "jarvis": {
    "directory": ".",
    "commands": {
      "tests": ["{python}", "-m", "unittest", "discover", "-s", "tests", "-v"]
    }
  },
  "my_web_project": {
    "directory": "D:/Projects/my_web_project",
    "commands": {
      "dev": ["D:/Projects/my_web_project/.venv/Scripts/python.exe", "-m", "uvicorn", "app:app", "--host", "127.0.0.1", "--port", "8000"]
    },
    "start": "dev"
  }
}
