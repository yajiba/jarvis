# Copy this file to .env or set these variables in your shell.
OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_MODEL=qwen3:8b
# Optional small model for greetings and lightweight conversation.
JARVIS_FAST_MODEL=gemma3:4b
JARVIS_CODING_MODEL=qwen2.5-coder:7b
# Optional long-context model for uploaded PDF, DOCX, PPTX, and text analysis.
JARVIS_DOCUMENT_MODEL=qwen3:8b
JARVIS_TIMEOUT_SECONDS=120
JARVIS_WHISPER_MODEL=base.en
JARVIS_AUDIO_SAMPLE_RATE=16000
JARVIS_WHISPER_DEVICE=cpu
JARVIS_TTS_ENABLED=false
# Piper voice model path (download from https://huggingface.co/rhasspy/piper-voices)
# Female voices:
#   en_US-amy-medium.onnx - Friendly female voice
#   en_US-libritts-high.onnx - Natural female voice (high quality, ~1GB)
#   en_GB-semaine-medium.onnx - British female voice
# Male voices:
#   en_US-lessac-medium.onnx - Natural male voice (default)
#   en_US-joe-medium.onnx - Deep male voice
JARVIS_PIPER_MODEL=models/piper/en_US-amy-medium.onnx
JARVIS_WAKEWORD_MODEL=hey_jarvis
JARVIS_WAKEWORD_THRESHOLD=0.5
JARVIS_WAKEWORD_COMMAND_SECONDS=6
JARVIS_VOICE_AGENT_ENABLED=true
# Semicolon-separated absolute folders JARVIS may inspect in addition to this project.
# JARVIS_ALLOWED_ROOTS=D:\Projects\sentrixv1;D:\Projects\other-project
JARVIS_WEB_ENABLED=true
# Enable semantic RAG with chromadb (requires: pip install -e ".[rag]")
JARVIS_RAG_SEMANTIC_ENABLED=false
# Phase 16: choose an installed Ollama model that supports images.
JARVIS_VISION_MODEL=gemma3:4b
JARVIS_GUI_ENABLED=false
JARVIS_CAMERA_INDEX=0
